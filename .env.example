NODE_ENV=development
SIFT_API_PORT=3001

DATABASE_URL=postgresql://sift:sift-local-password@127.0.0.1:54322/sift
DATABASE_API_POOL_MAX=10
DATABASE_WORKER_POOL_MAX=5
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=30000
POSTGRES_DB=sift
POSTGRES_USER=sift
POSTGRES_PASSWORD=sift-local-password
POSTGRES_PORT=54322

S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=sift-local-access
S3_SECRET_KEY=sift-local-secret-key
S3_BUCKET=sift-imports
S3_REQUEST_TIMEOUT_MS=3000
S3_PRESIGN_TTL_SECONDS=300
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

WORKER_POLL_INTERVAL_MS=1000
WORKER_LEASE_SECONDS=30
