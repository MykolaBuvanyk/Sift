          "name": "import_jobs_duplicate_count_nonnegative_check",
          "value": "\"import_jobs\".\"duplicate_count\" >= 0"
        },
        "import_jobs_lease_state_check": {
          "name": "import_jobs_lease_state_check",
          "value": "\n    (\"import_jobs\".\"status\" = 'running' and \"import_jobs\".\"claimed_at\" is not null and \"import_jobs\".\"lease_expires_at\" is not null and \"import_jobs\".\"lease_token\" is not null)\n    or\n    (\"import_jobs\".\"status\" <> 'running' and \"import_jobs\".\"claimed_at\" is null and \"import_jobs\".\"lease_expires_at\" is null and \"import_jobs\".\"lease_token\" is null)\n  "
        },
        "import_jobs_lease_window_check": {
          "name": "import_jobs_lease_window_check",
          "value": "\"import_jobs\".\"lease_expires_at\" is null or \"import_jobs\".\"lease_expires_at\" > \"import_jobs\".\"claimed_at\""
        },
        "import_jobs_terminal_state_check": {
          "name": "import_jobs_terminal_state_check",
          "value": "\n    (\"import_jobs\".\"status\" in ('completed', 'failed') and \"import_jobs\".\"finished_at\" is not null)\n    or\n    (\"import_jobs\".\"status\" in ('pending', 'running') and \"import_jobs\".\"finished_at\" is null)\n  "
        },
        "import_jobs_completed_bytes_check": {
          "name": "import_jobs_completed_bytes_check",
          "value": "\"import_jobs\".\"status\" <> 'completed' or \"import_jobs\".\"processed_bytes\" = \"import_jobs\".\"total_bytes\""
        },
        "import_jobs_upload_state_check": {
          "name": "import_jobs_upload_state_check",
          "value": "\n    (\"import_jobs\".\"uploaded_at\" is null and \"import_jobs\".\"content_hash\" is null)\n    or\n    (\"import_jobs\".\"uploaded_at\" is not null and \"import_jobs\".\"content_hash\" ~ '^[0-9a-f]{64}$')\n  "
        }
