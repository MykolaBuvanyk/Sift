{
  "name": "sift",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "src/contracts",
    "src/server"
  ],
  "scripts": {
    "dev": "next dev",
    "dev:api": "npm run dev:api --workspace=@sift/server",
    "dev:worker": "npm run dev:worker --workspace=@sift/server",
    "build": "npm run build --workspace=@sift/contracts && npm run build --workspace=@sift/server && next build",
    "build:dashboard": "next build",
    "build:server": "npm run build --workspace=@sift/server",
    "lint": "eslint .",
    "typecheck": "npm run build --workspace=@sift/contracts && npm run typecheck --workspace=@sift/contracts && npm run typecheck --workspace=@sift/server && tsc --noEmit",
    "test": "vitest run",
    "test:memory": "npm run build --workspace=@sift/contracts && npm run build:server && node --expose-gc --max-old-space-size=192 tests/memory/import-memory-stress.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "start": "next start"
  },
  "dependencies": {
    "@sift/contracts": "0.1.0",
    "@tanstack/react-query": "^5.101.4",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.3.0",
    "globals": "^16.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vitest": "^4.1.10"
  }
}
